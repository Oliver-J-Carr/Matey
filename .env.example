# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=sk-...

# The brain plans and uses tools; the voice only rewrites lines as Matey.
BRAIN_MODEL=
VOICE_MODEL=

# Optional: reasoning effort (e.g. low). Leave blank for the model default.
# Lower effort = faster replies. If a model rejects it, blank it again.
BRAIN_REASONING_EFFORT=
VOICE_REASONING_EFFORT=

# Max model calls the brain may make in one turn.
MAX_TURNS=12

# Each user turn appears in the OpenAI Traces dashboard under this name.
TRACE_WORKFLOW_NAME=Matey turn
# Set to true to stop sending traces to OpenAI.
OPENAI_AGENTS_DISABLE_TRACING=false
