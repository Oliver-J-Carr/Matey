# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=sk-...

# The brain plans and uses tools; the voice only rewrites lines as Matey.
BRAIN_MODEL=
VOICE_MODEL=

# Optional: reasoning effort (e.g. low). Leave blank for the model default.
# Lower effort = faster replies. If a model rejects it, blank it again.
BRAIN_REASONING_EFFORT=
VOICE_REASONING_EFFORT=

# Max model calls the brain may make in one turn.
MAX_TURNS=12

# Each user turn appears in the OpenAI Traces dashboard under this name.
TRACE_WORKFLOW_NAME=Matey turn
# Set to true to stop sending traces to OpenAI.
OPENAI_AGENTS_DISABLE_TRACING=false

# Optional: Matey's spoken voice (ElevenLabs text-to-speech) and the
# microphone button for spoken requests (ElevenLabs speech-to-text).
# Leave the key blank to turn both off; Matey is then text only.
ELEVENLABS_API_KEY=
# The Pirate Marshal voice.
ELEVENLABS_VOICE_ID=PPzYpIqttlTYA83688JI
# Text-to-speech model. Blank uses the default (eleven_v4_turbo).
ELEVENLABS_MODEL=
# Speaking speed: 1.0 is normal, 0.7 (slower) to 1.2 (faster). Blank uses 1.1.
ELEVENLABS_SPEED=
# Speech-to-text model for spoken requests. Blank uses the default (scribe_v2).
ELEVENLABS_STT_MODEL=
